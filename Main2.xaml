<ui:FluentWindow x:Class="RegistryToolbox.Main2"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:RegistryToolbox"
                 xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
                 xmlns:models="clr-namespace:RegistryToolbox.Models"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
                 mc:Ignorable="d"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Title="Registry Toolbox"
                 MinHeight="768"
                 MinWidth="1024">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.Header>
                <ui:BreadcrumbBar Margin="42,32,0,0"
                                  FontSize="28"
                                  FontWeight="DemiBold" />
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Load Registry"
                                       NavigationCacheMode="Enabled"
                                       Tag="LoadRegistryPage"
                                       Click="NavigationViewItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Open16" />
                    </ui:NavigationViewItem.Icon>

                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Compare Registries"
                                       NavigationCacheMode="Enabled">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BookOpen16" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Cloud Registry Repository (Very Soon)"
                                       NavigationCacheMode="Enabled">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CloudArrowDown48" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                       NavigationCacheMode="Disabled">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="About"
                                       NavigationCacheMode="Disabled">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem  Click="Button_Click"
                                       NavigationCacheMode="Disabled">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DarkTheme20" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:Button Grid.Row="0"
                   Appearance="Secondary"
                   HorizontalAlignment="Right"
                   Margin="0,0,150,0"
                   Icon="{ui:SymbolIcon Symbol=DarkTheme20}"
                  >
        </ui:Button>


        <ui:TitleBar Title="Registry Toolbox 2"
                         FontSize="18" Grid.Row="0">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="/Resources/registry.ico" />
                </ui:TitleBar.Icon>
               
            </ui:TitleBar>
       



        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,15,0">
           
            <TextBlock Text="German Vives © 2025  Version 2.0" />
        </StackPanel>


    </Grid>
</ui:FluentWindow>